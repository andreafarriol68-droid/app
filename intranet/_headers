# Cabeceras de seguridad para la intranet. Las aplican Cloudflare Pages y Netlify
# automáticamente al publicar esta carpeta (GitHub Pages no las admite).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://andreafarriol68-droid.github.io; font-src 'self'; connect-src 'self' https://sjzjneckpkwvgxrtdcgo.supabase.co; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
